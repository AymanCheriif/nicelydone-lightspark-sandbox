# Lightspark Grid API base URL (sandbox + production share this; tokens are
# environment-scoped). Override only if Grid documents a different version.
GRID_API_BASE_URL=https://api.lightspark.com/grid/2025-10-13

# --- Sandbox Payments token (primary; used by src/payments.js) ---
LIGHTSPARK_API_TOKEN_CLIENT_ID=
LIGHTSPARK_API_TOKEN_CLIENT_SECRET=

# --- Sandbox Webhooks token ---
WEBHOOKS_API_TOKEN_CLIENT_ID=
WEBHOOKS_API_TOKEN_CLIENT_SECRET=

# --- Sandbox Reconciliation token ---
RECONCILIATION_API_TOKEN_CLIENT_ID=
RECONCILIATION_API_TOKEN_CLIENT_SECRET=

# Grid webhook signing key (PEM public key from the dashboard webhook config).
# Used by src/webhook.js to verify the X-Grid-Signature header (ECDSA P-256).
LIGHTSPARK_WEBHOOK_SIGNING_KEY=

# Local webhook server port
PORT=3000
