# Lightspark API token credentials (create at https://app.lightspark.com, REGTEST environment)
LIGHTSPARK_API_TOKEN_CLIENT_ID=
LIGHTSPARK_API_TOKEN_CLIENT_SECRET=

# Your Lightspark node (REGTEST). Node ID looks like: LightsparkNodeWithOSKLND:0187...
LIGHTSPARK_NODE_ID=
# Password used to unlock/recover the node signing key
LIGHTSPARK_NODE_PASSWORD=

# Signing key configured for your Lightspark webhook endpoint
LIGHTSPARK_WEBHOOK_SIGNING_KEY=

# Local webhook server port
PORT=3000
